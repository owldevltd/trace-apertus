# Copy to .env and fill in. The app reads these from the environment; Docker passes them with --env-file .env.

# OpenAI-compatible endpoint that serves Apertus, and the key for it.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=

# Where the app listens.
PORT=8080

# Shipped forms and the working folder; the defaults are the project folders.
# DATA_DIR=./data
# STORAGE_DIR=./storage
